/build/
/.vs/

# Fetched via CMake's FetchContent (see CMakeLists.txt's "newui - Dependency" section) from
# https://github.com/jimcrafton/newui.git's "cpptools" branch - not vendored as a committed copy
# like 3rdparty/googletest, so this is regenerated by `cmake -S . -B build` and shouldn't be
# tracked.
/3rdparty/newui/

*.log

# extension/ - codetools++ VSIX build output (C# bin/obj, native vcxproj x64/obj, VS's own .vs/)
extension/**/bin/
extension/**/obj/
extension/**/x64/
extension/**/*.user
extension/.vs/
