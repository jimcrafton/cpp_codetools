<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <!-- This machine has a machine-wide C:\Program Files (x86)\NuGet\Config\Microsoft.VisualStudio.FallbackLocation.config
       pointing at a "Microsoft Visual Studio Fallback Folder" that doesn't exist on disk. NuGet.Config
       <clear/> under packageSources doesn't touch this - it's a separate section - so it still gets
       merged in and breaks the build's ResolvePackageAssets task even after restore succeeds
       (same issue documented in D:\code\CppNativeEditorVsix's own NuGet.Config). Clear it too. -->
  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>
</configuration>
