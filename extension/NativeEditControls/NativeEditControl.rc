#include <windows.h>
#include <cpptools/version.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION CPPTOOLS_VERSION_MAJOR,CPPTOOLS_VERSION_MINOR,CPPTOOLS_VERSION_RELEASE,CPPTOOLS_VERSION_BUILD
 PRODUCTVERSION CPPTOOLS_VERSION_MAJOR,CPPTOOLS_VERSION_MINOR,CPPTOOLS_VERSION_RELEASE,CPPTOOLS_VERSION_BUILD
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x2L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", CPPTOOLS_AUTHOR
            VALUE "FileDescription", CPPTOOLS_DESCRIPTION
            VALUE "FileVersion", CPPTOOLS_VERSION_STRING
            VALUE "InternalName", "NativeEditControls.dll"
            VALUE "LegalCopyright", CPPTOOLS_COPYRIGHT
            VALUE "OriginalFilename", "NativeEditControls.dll"
            VALUE "ProductName", CPPTOOLS_PRODUCT_NAME
            VALUE "ProductVersion", CPPTOOLS_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
