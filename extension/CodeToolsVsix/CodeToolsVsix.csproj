<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <RootNamespace>CodeToolsVsix</RootNamespace>
    <AssemblyName>CodeToolsVsix</AssemblyName>

    <!-- VSIX / VS package plumbing -->
    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
    <IncludeDebugSymbolsInVSIXContainer>false</IncludeDebugSymbolsInVSIXContainer>
    <IncludeDebugSymbolsInLocalVSIXDeployment>false</IncludeDebugSymbolsInLocalVSIXDeployment>
    <CopyBuildOutputToOutputDirectory>true</CopyBuildOutputToOutputDirectory>
    <CopyOutputSymbolsToOutputDirectory>true</CopyOutputSymbolsToOutputDirectory>
    <StartAction>Program</StartAction>
    <StartProgram Condition="'$(DevEnvDir)' != ''">$(DevEnvDir)devenv.exe</StartProgram>
    <StartArguments>/rootsuffix Exp</StartArguments>
    <UseCodebase>true</UseCodebase>

    <!-- In-proc VS packages that implement legacy COM editor interfaces (IVsEditorFactory,
         IVsWindowPane) must be .NET Framework - the shell loads them in-proc, not OOP. -->
    <UseWindowsForms>false</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>AnyCPU;x64</Platforms>
    <ExtensionInstallationRoot>CommonExtensions</ExtensionInstallationRoot>
    <ExtensionInstallationFolder>Microsoft\CodeToolsVsix</ExtensionInstallationFolder>

    <MinimumVisualStudioVersion>17.0</MinimumVisualStudioVersion>

    <!-- Microsoft.VSSDK.BuildTools ships its own self-contained VsSDK.targets/toolchain under
         its NuGet package (tools\VSSDK\), so building doesn't require Visual Studio to be
         installed on the build machine - but that import is opt-in and skipped unless this is
         set. -->
    <VSSDKBuildToolsAutoSetup>true</VSSDKBuildToolsAutoSetup>

    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Deterministic>true</Deterministic>

    <!-- Used both to configure the CMake build below (-DCPPCODETOOLS_LLVM_ROOT=...) and to locate
         libclang.dll for deployment. Override with /p:LLVMInstallDir=... if LLVM isn't installed
         at the default location - same property name/default as this repo's root CMakeLists.txt
         (CPPCODETOOLS_LLVM_ROOT), kept in sync via -D below so an override actually reaches the
         native build, not just the deployment-file lookup. -->
    <LLVMInstallDir Condition="'$(LLVMInstallDir)'==''">C:\Program Files\LLVM</LLVMInstallDir>

    <!-- cpp_codetools' own repo root and CMake build directory (extension/CodeToolsVsix -> up
         two levels). NativeEditControl.dll is a CMake target (root CMakeLists.txt), built by
         invoking cmake directly against this build tree before deploying its output alongside
         this assembly - it isn't an MSBuild project and so isn't picked up by the .sln's
         ProjectDependencies ordering (indeed, it isn't in the .sln at all). -->
    <!-- No trailing backslash: one right before a closing quote in an Exec Command escapes the
         quote itself (classic Windows command-line argument parsing gotcha) and corrupts the
         next argument - observed first-hand getting the cmake build invocation below working. -->
    <RepoRoot>$(MSBuildThisFileDirectory)..\..</RepoRoot>
    <RepoBuildDir>$(RepoRoot)\build</RepoBuildDir>

    <!-- cmake isn't on PATH in a plain shell on this machine (see repo CLAUDE.md) - default to
         VS 2026's own bundled copy rather than requiring a system-wide install. Override with
         /p:CMakeExe=... if yours is elsewhere. -->
    <CMakeExe Condition="'$(CMakeExe)'==''">$(DevEnvDir)CommonExtensions\Microsoft\CMake\CMake\bin\cmake.exe</CMakeExe>
  </PropertyGroup>

  <ItemGroup>
    <!-- Meta-package pulling in the VS shell / editor / OLE interop assemblies.
         Bump this to match the SDK version shipped for your installed VS build
         if VS 2026 publishes its own package line (17.14.x is current as of Aug 2026). -->
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.14.40265" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="18.9.820" />
  </ItemGroup>

  <ItemGroup>
    <None Include="source.extension.vsixmanifest" SubType="Designer" />
  </ItemGroup>

  <!-- NativeEditControl.dll (native, edit-surface HWND - a CMake target, root CMakeLists.txt)
       and libclang.dll (cpptools's own runtime dependency) are native code NativeEditHost.cs
       P/Invokes into or that NativeEditControl.dll needs alongside it. They need to sit next to
       CodeToolsVsix.dll at runtime and travel inside the .vsix, since VS loads them from the
       extension's install folder, not from this project's own build output. There is no separate
       C API/bridge DLL - NativeEditControl.dll calls cpptools::Parser in-process (see
       CppEditorControl.cpp), and hosts a real newui::RootView the same way (see
       EditThreadHost.cpp).

       This is done as an imperative Target rather than plain <Content Include> items pointing at
       the CMake build's own output path: a static Content item's Exists() condition is evaluated
       when this project is first loaded, before any build has actually happened, so on a clean
       checkout it would (wrongly) evaluate to false and silently omit the DLLs. Building
       NativeEditControl via CMake explicitly here - which transitively builds cpptools/newui too,
       since it links both - rather than relying on any MSBuild-level project ordering (there is
       none; NativeEditControl isn't in the .sln at all) - also means `dotnet build` on just this
       .csproj still produces a working, deployable extension on a machine with the VC++ toolset
       and CMake available. -->
  <Target Name="BuildAndIncludeNativeDependencies" BeforeTargets="CoreCompile;GetVsixSourceItems" Condition="'$(DesignTimeBuild)' != 'true'">
    <!-- First-time configure, mirroring the repo's own documented "cmake -S . -B build" step -
         lets a clean checkout of this repo build the extension without a manual CMake step first.
         -DCPPCODETOOLS_LLVM_ROOT keeps a /p:LLVMInstallDir=... override in sync with the actual
         native build, not just the deployment-file lookup below. -->
    <Exec Command="&quot;$(CMakeExe)&quot; -S &quot;$(RepoRoot)&quot; -B &quot;$(RepoBuildDir)&quot; -DCPPCODETOOLS_LLVM_ROOT=&quot;$(LLVMInstallDir)&quot;"
          Condition="!Exists('$(RepoBuildDir)\CMakeCache.txt')" />

    <!-- Builds NativeEditControl.dll - transitively builds cpptools and newui too, since it
         links both (target_link_libraries(NativeEditControl PRIVATE cpptools newui), root
         CMakeLists.txt) - one call covers everything this project needs from the native side. -->
    <Exec Command="&quot;$(CMakeExe)&quot; --build &quot;$(RepoBuildDir)&quot; --config $(Configuration) --target NativeEditControl" />

    <ItemGroup>
      <_NativeDeploymentFile Include="$(RepoBuildDir)\$(Configuration)\NativeEditControl.dll" />
      <_NativeDeploymentFile Include="$(LLVMInstallDir)\bin\libclang.dll" />
    </ItemGroup>

    <Error Condition="!Exists('$(LLVMInstallDir)\bin\libclang.dll')"
           Text="libclang.dll not found under LLVMInstallDir ('$(LLVMInstallDir)\bin'). Install LLVM (https://github.com/llvm/llvm-project/releases) or pass /p:LLVMInstallDir=... pointing at your install." />

    <!-- Belt-and-suspenders: a dynamically-added Content item's CopyToOutputDirectory metadata
         isn't guaranteed to be picked up by the standard output-copy pipeline (AssignTargetPaths
         may already have snapshotted @(Content) by the time this target runs), so copy into
         OutDir imperatively too - that part must not depend on pipeline-ordering nuance. -->
    <Copy SourceFiles="@(_NativeDeploymentFile)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />

    <ItemGroup>
      <Content Include="@(_NativeDeploymentFile)">
        <Link>%(Filename)%(Extension)</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <IncludeInVSIX>true</IncludeInVSIX>
      </Content>
    </ItemGroup>
  </Target>

</Project>
